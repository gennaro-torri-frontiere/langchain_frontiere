{
    "name": "LangChain Frontiere Dev Container",
    "dockerComposeFile": "../docker-compose.yml",
    "envFile": "../.env",
    "service": "langchain_rag",
    "runServices": [],
    "workspaceFolder": "/app",
    "shutdownAction": "stopContainer",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint"
            ]
        }
    },
    "remoteEnv": {
        "COMPOSE_PROJECT_NAME": "langchain_frontiere"
    }
}
